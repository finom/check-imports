{
  "name": "check-imports",
  "version": "1.0.8",
  "description": "Finds missing and unused dependencies by reading the imports of a JavaScript or TypeScript project, monorepos included",
  "keywords": [
    "dependencies",
    "imports",
    "package.json",
    "unused-dependencies",
    "missing-dependencies",
    "monorepo",
    "typescript",
    "cli"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/api/index.d.mts",
      "default": "./dist/api/index.mjs"
    }
  },
  "main": "./dist/api/index.mjs",
  "types": "./dist/api/index.d.mts",
  "bin": {
    "check-imports": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "biome check --error-on-warnings .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/types",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=\"dist/**\" --test-coverage-lines=100 --test-coverage-branches=95 --test-coverage-functions=100 \"test/*.test.mjs\"",
    "check:dist": "node scripts/check-dist.mjs",
    "check-imports": "node dist/cli.mjs -d src -e",
    "patch": "node scripts/release.mjs patch",
    "minor": "node scripts/release.mjs minor",
    "major": "node scripts/release.mjs major",
    "prepublishOnly": "node scripts/ci-only.mjs"
  },
  "author": "Andrey Gubanov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finom/check-imports.git"
  },
  "homepage": "https://github.com/finom/check-imports#readme",
  "bugs": "https://github.com/finom/check-imports/issues",
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "find-up": "^8.0.0",
    "glob": "^13.0.6",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
